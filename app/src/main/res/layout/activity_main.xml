<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/top_bar_height"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/top_bar_padding_horizontal">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/top_bar_back_button_size"
            android:layout_height="@dimen/top_bar_back_button_size"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/topTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Once Collection Weekly"
            android:textColor="@color/black"
            android:textSize="@dimen/top_bar_title_size"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="@dimen/top_bar_icon_button_size"
            android:layout_height="@dimen/top_bar_icon_button_size"
            android:background="@android:color/transparent"
            android:contentDescription="Wishlist"
            android:padding="@dimen/top_bar_icon_padding"
            android:src="@drawable/ic_favorite_border" />

        <ImageButton
            android:id="@+id/shareButtonTop"
            android:layout_width="@dimen/top_bar_icon_button_size"
            android:layout_height="@dimen/top_bar_icon_button_size"
            android:background="@android:color/transparent"
            android:contentDescription="Share"
            android:padding="@dimen/top_bar_icon_padding"
            android:src="@drawable/ic_share" />

        <ImageButton
            android:id="@+id/bagButton"
            android:layout_width="@dimen/top_bar_icon_button_size"
            android:layout_height="@dimen/top_bar_icon_button_size"
            android:background="@android:color/transparent"
            android:contentDescription="Bag"
            android:padding="@dimen/top_bar_icon_padding"
            android:src="@drawable/ic_bag" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/top_bar_height"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/scroll_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/imagePager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="300dp" />

            <LinearLayout
                android:id="@+id/pageDotsContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/page_dots_container_height"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/content_padding_horizontal"
                android:paddingBottom="@dimen/content_padding_bottom">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/brandText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        android:textSize="@dimen/brand_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/priceText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/price_text_size"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/productName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/product_name_text_size" />

                <TextView
                    android:id="@+id/skuText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_light"
                    android:textSize="@dimen/sku_text_size" />

                <TextView
                    android:id="@+id/colorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Color:"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/section_label_text_size" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/colorList"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/color_list_height"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="2dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/installmentCard"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/installment_card_height"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="7dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <TextView
                            android:id="@+id/installmentText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="or 4 interest-free payments&#10;0.88 KWD"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/installment_text_size" />

                        <TextView
                            android:id="@+id/learnMoreText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Learn More"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/learn_more_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_tabby"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="4dp"
                            android:text="tabby"
                            android:textColor="@color/black"
                            android:textSize="@dimen/tabby_badge_text_size"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/quantityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="Quantity"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/quantity_label_text_size" />

                <LinearLayout
                    android:id="@+id/quantityContainer"
                    android:layout_width="@dimen/quantity_container_width"
                    android:layout_height="@dimen/quantity_container_height"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/minusButton"
                        android:layout_width="@dimen/quantity_button_width"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_quantity_button"
                        android:enabled="false"
                        android:gravity="center"
                        android:text="-"
                        android:textColor="@color/white"
                        android:textSize="@dimen/quantity_button_text_size" />

                    <TextView
                        android:id="@+id/quantityText"
                        android:layout_width="@dimen/quantity_text_width"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_outline"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/text_dark"
                        android:textSize="@dimen/quantity_value_text_size" />

                    <TextView
                        android:id="@+id/plusButton"
                        android:layout_width="@dimen/quantity_button_width"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_quantity_button"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/white"
                        android:textSize="@dimen/quantity_button_text_size" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/productInfoHeader"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/product_info_header_height"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PRODUCT INFORMATION"
                        android:textColor="@color/text_dark"
                        android:textSize="@dimen/product_info_header_text_size" />

                    <ImageView
                        android:id="@+id/productInfoArrow"
                        android:layout_width="@dimen/product_info_arrow_size"
                        android:layout_height="@dimen/product_info_arrow_size"
                        android:contentDescription="Expand product information"
                        android:rotation="180"
                        android:src="@drawable/ic_expand" />
                </LinearLayout>

                <TextView
                    android:id="@+id/descriptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_light"
                    android:textSize="@dimen/description_text_size" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/bottom_bar_padding_horizontal"
        android:paddingTop="@dimen/bottom_bar_padding_top"
        android:paddingBottom="@dimen/bottom_bar_padding_bottom">

        <TextView
            android:id="@+id/addToBagButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/primary_button_height"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="Add to bag"
            android:textColor="@color/white"
            android:textSize="@dimen/button_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shareButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/secondary_button_height"
            android:layout_marginTop="@dimen/button_space"
            android:background="@drawable/bg_share_button"
            android:gravity="center"
            android:text="Share"
            android:textColor="@color/black"
            android:textSize="@dimen/button_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:minWidth="120dp"
            android:paddingHorizontal="24dp"
            android:text="Retry"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>